{
  "uid": "txloom-analytics",
  "title": "TxLoom Stream Analytics",
  "tags": [
    "txloom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events / sec",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "txloom-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT uniqExactMerge(events) / (dateDiff('second', $__fromTime, $__toTime) + 1) AS eps\nFROM txloom_analytics.events_1m\nWHERE $__timeFilter(minute)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "txloom-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT uniqExactMerge(events) AS events\nFROM txloom_analytics.events_1m\nWHERE $__timeFilter(minute)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Amount",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "txloom-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sumMerge(amount) AS amount\nFROM txloom_analytics.events_1m\nWHERE $__timeFilter(minute)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Includes duplicate deliveries (rollup)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Duplicate deliveries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "txloom-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() - uniqExact(event_id) AS duplicates\nFROM txloom_analytics.events_raw\nWHERE $__timeFilter(ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events per minute by type",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "txloom-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT minute AS time, type, uniqExactMerge(events) AS events\nFROM txloom_analytics.events_1m\nWHERE $__timeFilter(minute)\nGROUP BY time, type\nORDER BY time"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Amount per minute by currency",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
