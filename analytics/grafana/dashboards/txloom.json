        "uid": "txloom-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "txloom-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT minute AS time, status, uniqExactMerge(events) AS events\nFROM txloom_analytics.events_1m\nWHERE $__timeFilter(minute)\nGROUP BY time, status\nORDER BY time"
        }
      ],
      "options": {},
